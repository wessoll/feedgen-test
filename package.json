{
  "name": "fediverse-gen",
  "version": "1.0.0",
  "description": "A very basic atproto (Bluesky) feed generator serving hardcoded posts, based on bluesky-social/feed-generator",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
